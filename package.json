{
  "name": "ops-rbac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run copy:assets",
    "dev": "vite",
    "prebuild": "npm run copy:assets",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:design-qa": "playwright test",
    "test:design-qa:install": "playwright install chromium",
    "test:design-qa:update": "playwright test --update-snapshots",
    "test:design-qa:report": "playwright show-report playwright-report",
    "copy:assets": "npm run copy:images && npm run copy:favicons && npm run copy:fonts",
    "copy:images": "copyfiles -E -f \"node_modules/@ongov/ontario-design-system-component-library-react/dist/assets/images/**\" public/assets",
    "copy:favicons": "copyfiles -E -f \"node_modules/@ongov/ontario-design-system-component-library-react/dist/assets/favicons/**\" public/assets/favicons",
    "copy:fonts": "copyfiles -E -u 6 \"node_modules/@ongov/ontario-design-system-component-library-react/dist/assets/fonts/**/*\" public/assets/fonts",
    "sync:ods-docs": "node scripts/sync-ods-docs.mjs",
    "postinstall": "npm run sync:ods-docs"
  },
  "dependencies": {
    "@ongov/ontario-design-system-component-library-react": "8.1.0",
    "@ongov/ontario-design-system-design-tokens": "8.1.0",
    "@ongov/ontario-design-system-global-styles": "8.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "copyfiles": "^2.4.1",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
